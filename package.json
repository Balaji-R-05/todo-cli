{
  "name": "todo-cli",
  "version": "1.2.0",
  "description": "A simple command-line todo manager built with Node.js, Commander, and Chalk.",
  "main": "todo.js",
  "scripts": {
    "dev": "node todo.js show",
    "test": "node --test",
    "build:bundle": "node scripts/bundle.js",
    "build:binary": "node scripts/build-binary.js"
  },
  "keywords": [
    "todo",
    "cli",
    "task-manager",
    "productivity",
    "commander",
    "chalk",
    "nodejs"
  ],
  "author": "Balaji-R-05",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "chalk": "^5.5.0",
    "commander": "^14.0.0"
  },
  "bin": {
    "todo": "./todo.js"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
